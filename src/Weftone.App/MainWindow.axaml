<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weftone.App.ViewModels"
        xmlns:controls="using:Weftone.App.Controls"
        xmlns:domain="using:Weftone.Domain"
        x:Class="Weftone.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="560">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="工程(_F)">
        <MenuItem Header="演示工程(_D)" Command="{Binding NewDemoCommand}" />
        <MenuItem Header="打开(_O)..." Command="{Binding OpenCommand}" />
        <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="8" Background="#202020">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="PlayButton" Content="播放" Command="{Binding PlayCommand}" />
        <Button x:Name="StopButton" Content="停止" Command="{Binding StopCommand}" />
        <Separator />
        <ToggleButton x:Name="SongModeToggle" Content="Song 模式"
                      IsChecked="{Binding IsSongMode}" />
        <TextBlock Text="Pattern" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}" Width="110">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="domain:Pattern">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Separator />
        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Width="90" />
        <TextBlock Text="BPM" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Tempo}" VerticalAlignment="Center" Width="40" />
        <Separator />
        <Button Content="撤销" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
        <Button Content="重做" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#202020">
      <TextBlock Text="{Binding StatusText}" />
    </Border>

    <Grid RowDefinitions="*,5,2*" Background="#181818">
      <Grid Grid.Row="0" ColumnDefinitions="110,*">
        <Border Background="#202020">
          <ItemsControl ItemsSource="{Binding Patterns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:Pattern">
                <Border Height="28" BorderBrush="#101014" BorderThickness="0,0,0,1">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0"
                             Foreground="#C8C8CC" TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <ScrollViewer Grid.Column="1" x:Name="PlaylistScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <controls:PlaylistControl x:Name="Playlist"
                                    Patterns="{Binding Patterns}"
                                    Playlist="{Binding PlaylistClips}"
                                    ViewModel="{Binding}" />
        </ScrollViewer>
      </Grid>

      <Rectangle Grid.Row="1" Fill="#101014" />

      <Grid Grid.Row="2" ColumnDefinitions="72,*">
        <controls:PianoKeysControl x:Name="Keys" />
        <ScrollViewer Grid.Column="1" x:Name="RollScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <controls:PianoRollControl x:Name="Roll"
                                     Pattern="{Binding SelectedPattern}"
                                     ViewModel="{Binding}" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>